<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AudioStudio.ViewModels.Dsp"
             x:Class="AudioStudio.Views.Dsp.DspView"
             x:DataType="vm:DspViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="8">

        <!-- 音量与均衡 -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                <!-- 音量控制 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="音量:" VerticalAlignment="Center" />
                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2"
                        Value="{Binding Volume}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Volume, StringFormat='{}{F2}x'}"
                           VerticalAlignment="Center" Width="40" />
                <CheckBox Grid.Row="0" Grid.Column="3" Content="静音" IsChecked="{Binding IsMuted}" />

                <!-- 声像 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="声像:" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="1"
                        Value="{Binding Pan}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Pan, StringFormat='{}{F2}'}"
                           VerticalAlignment="Center" Width="40" />

                <!-- 三段均衡 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="均衡:" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="低音" FontSize="11" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding BassGain}" Width="80" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="中音" FontSize="11" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding MidGain}" Width="80" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="高音" FontSize="11" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding TrebleGain}" Width="80" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="3" Content="重置" Command="{Binding ResetEqualizerCommand}" />
            </Grid>
        </Border>

        <!-- 图示均衡器 10段 -->
        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="10段图示均衡器" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- 10段 EQ 滑块 -->
                    <StackPanel Margin="2,0">
                        <TextBlock Text="31" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq31Hz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="62" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq62Hz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="125" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq125Hz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="250" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq250Hz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="500" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq500Hz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="1k" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq1kHz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="2k" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq2kHz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="4k" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq4kHz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="8k" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq8kHz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                    <StackPanel Margin="2,0">
                        <TextBlock Text="16k" FontSize="9" HorizontalAlignment="Center" />
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Eq16kHz}" Orientation="Vertical" Height="120" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 滤镜与变速 -->
        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                <!-- 低通 -->
                <CheckBox Grid.Row="0" Grid.Column="0" Content="低通滤波器" IsChecked="{Binding EnableLowPass}" />
                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding EnableLowPass}">
                    <TextBlock Grid.Column="0" Text="截止:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider Grid.Column="1" Minimum="20" Maximum="20000" Value="{Binding LowPassCutoff}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding LowPassCutoff, StringFormat='{}{F0} Hz'}" Width="70" VerticalAlignment="Center" Margin="4,0,0,0" />
                </Grid>

                <CheckBox Grid.Row="1" Grid.Column="0" Content="高通滤波器" IsChecked="{Binding EnableHighPass}" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding EnableHighPass}">
                    <TextBlock Grid.Column="0" Text="截止:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider Grid.Column="1" Minimum="20" Maximum="20000" Value="{Binding HighPassCutoff}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding HighPassCutoff, StringFormat='{}{F0} Hz'}" Width="70" VerticalAlignment="Center" Margin="4,0,0,0" />
                </Grid>
            </Grid>
        </Border>

        <!-- 变速变调 -->
        <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="速度:" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0.25" Maximum="4" Value="{Binding Speed}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Speed, StringFormat='{}{F2}x'}" Width="50" VerticalAlignment="Center" Margin="4,0" />

                <TextBlock Grid.Column="3" Text="音高:" VerticalAlignment="Center" />
                <Slider Grid.Column="4" Minimum="0.25" Maximum="4" Value="{Binding Pitch}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding Pitch, StringFormat='{}{F2}x'}" Width="50" VerticalAlignment="Center" Margin="4,0" />
            </Grid>
        </Border>

        <!-- 频谱分析 -->
        <Border Grid.Row="4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="频谱分析（模拟数据）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ItemsControl Grid.Row="1" ItemsSource="{Binding SpectrumBins}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SystemControlAccentBrush}"
                                    Width="12" Margin="1,0"
                                    Height="{Binding Converter={StaticResource SpectrumBarConverter}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="FFT: 1024" FontSize="11" Margin="0,0,16,0"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <Button Content="频谱模拟" Command="{Binding ResetAllCommand}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
