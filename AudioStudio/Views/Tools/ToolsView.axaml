<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AudioStudio.ViewModels.Tools"
             x:Class="AudioStudio.Views.Tools.ToolsView"
             x:DataType="vm:ToolsViewModel">

    <TabControl SelectedIndex="{Binding SelectedTab}" Margin="8">
        <!-- 编解码器注册表 -->
        <TabItem Header="编解码器">
            <Grid RowDefinitions="Auto,*" Margin="4">
                <TextBlock Grid.Row="0" Text="已注册编解码器" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" ItemsSource="{Binding CodecList}"
                         SelectedItem="{Binding SelectedCodec}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding AvType}" FontSize="12" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding IsStateful}" FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SupportedTypes}" FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>

        <!-- PCM 查看器 -->
        <TabItem Header="PCM 查看">
            <Grid RowDefinitions="Auto,*,Auto" Margin="4" RowSpacing="8">
                <TextBox Grid.Row="0" Text="{Binding PcmHexInput}"
                         Watermark="粘贴十六进制数据 (如: FF 00 FF 00)..."
                         AcceptsReturn="False" Height="60" />
                <ScrollViewer Grid.Row="1">
                    <TextBox Text="{Binding PcmHexOutput}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="加载示例" Command="{Binding ParsePcmCommand}" Margin="0,0,8,0" />
                    <Button Content="清空" Command="{Binding ClearPcmCommand}" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- RTP 分析 -->
        <TabItem Header="RTP 分析">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="4" RowSpacing="8">
                <TextBox Grid.Row="0" Text="{Binding RtpInput}"
                         Watermark="粘贴 RTP 包十六进制数据..."
                         AcceptsReturn="False" Height="60" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="加载示例" Command="{Binding LoadSampleRtpCommand}" Margin="0,0,8,0" />
                    <Button Content="解析" Command="{Binding ParseRtpCommand}" Margin="0,0,8,0" />
                    <Button Content="清空日志" Command="{Binding ClearRtpCommand}" />
                </StackPanel>

                <!-- 解析结果 -->
                <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="8"
                        IsVisible="{Binding RtpParsedPacket, Converter={StaticResource IsNotNullConverter}}">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="序列号:" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RtpParsedPacket.SequenceNumber}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="时间戳:" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RtpParsedPacket.Timestamp}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SSRC:" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RtpParsedPacket.Ssrc, StringFormat='{}{X8}'}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="负载类型:" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RtpParsedPacket.PayloadType}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="负载长度:" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RtpParsedPacket.PayloadLength}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="标记:" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RtpParsedPacket.Marker}" />
                    </Grid>
                </Border>

                <!-- 历史记录 -->
                <ListBox Grid.Row="3" ItemsSource="{Binding RtpPackets}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SequenceNumber, StringFormat='Seq={0} | TS={1} | SSRC={2}'}"
                                       FontSize="12" Margin="2,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="4" Text="{Binding RtpStatus}"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
            </Grid>
        </TabItem>

        <!-- VAD 测试 -->
        <TabItem Header="VAD 测试">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="4" RowSpacing="8">
                <!-- 参数 -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="激进模式:" VerticalAlignment="Center" />
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="3" TickFrequency="1"
                            Value="{Binding VadAggressiveness}" IsSnapToTickEnabled="True" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="测试频率(Hz):" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="100" Maximum="4000"
                                   Value="{Binding VadTestToneFrequency}" Increment="100" Width="120" />
                </Grid>

                <!-- 状态指示 -->
                <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Ellipse Grid.Column="0" Width="24" Height="24" Stroke="Gray" StrokeThickness="2"
                                 Fill="{Binding VadResult, Converter={StaticResource VadStateConverter}}" />
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding VadProbability, StringFormat='语音概率: {0:P1}'}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VadStatus}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="▸ 开始测试" Command="{Binding VadStartTestCommand}" Margin="0,0,8,0"
                                    IsEnabled="{Binding VadIsRunning, Converter={StaticResource InvertBoolConverter}}" />
                            <Button Content="■ 停止" Command="{Binding VadStopCommand}" Margin="0,0,8,0"
                                    IsEnabled="{Binding VadIsRunning}" />
                            <Button Content="清空" Command="{Binding VadClearCommand}"
                                    IsEnabled="{Binding VadIsRunning, Converter={StaticResource InvertBoolConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 概率条 -->
                <ProgressBar Grid.Row="2" Minimum="0" Maximum="1" Value="{Binding VadProbability}"
                             Height="20" CornerRadius="4" />

                <!-- 日志 -->
                <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        Padding="4" CornerRadius="4">
                    <TextBlock Text="VAD 检测日志" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <ListBox Grid.Row="4" ItemsSource="{Binding VadLog}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" Margin="2,1" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
