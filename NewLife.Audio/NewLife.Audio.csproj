<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;netstandard2.0;net461</TargetFrameworks>
    <AssemblyTitle>NewLife Audio Library</AssemblyTitle>
    <Description>Cross-platform, pure-managed .NET audio library: codecs (G.711/G.722/G.726/ADPCM/Opus/MP3/AAC/FLAC/Vorbis/Speex), device I/O (WaveOut/WASAPI/ASIO), DSP effects, speech processing (VAD/AEC/AGC/NS), container formats (WAV/Ogg/MP4/FLAC) and streaming (RTP/RTSP/HTTP/WebSocket). NativeAOT-ready, with built-in runtime localization for 31 languages; targets 3 frameworks from .NET Framework 4.6.1 to .NET Standard 2.1.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 新生命开发团队</Copyright>
    <VersionPrefix>1.3</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <!-- 与历史通配符版本保持同一 build 编号（2000-01-01 起的天数），revision 固定为上限 65534，
         使多 TFM 产物版本一致且对已发布包单调递增，同时保持可重现构建 -->
    <BuildNumber>$([MSBuild]::Divide($([MSBuild]::Subtract($([System.DateTime]::Now.Ticks), 630822816000000000)), 864000000000))</BuildNumber>
    <AssemblyVersion>$(VersionPrefix).$(BuildNumber).65534</AssemblyVersion>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <PackageDescription>Cross-platform, pure-managed .NET audio library: codecs (G.711/G.722/G.726/ADPCM/Opus/MP3/AAC/FLAC/Vorbis/Speex), device I/O (WaveOut/WASAPI/ASIO), DSP effects, speech processing (VAD/AEC/AGC/NS), container formats (WAV/Ogg/MP4/FLAC) and streaming (RTP/RTSP/HTTP/WebSocket). NativeAOT-ready, with built-in runtime localization for 31 languages; targets 3 frameworks from .NET Framework 4.6.1 to .NET Standard 2.1. 跨平台纯托管 .NET 音频库：编解码（G.711/G.722/G.726/ADPCM/Opus/MP3/AAC/FLAC/Vorbis/Speex）、音频设备 IO（WaveOut/WASAPI/ASIO）、DSP 音效、语音处理（VAD/AEC/AGC/NS）、容器格式（WAV/Ogg/MP4/FLAC）与流媒体传输（RTP/RTSP/HTTP/WebSocket）；原生 AOT 就绪，内置 31 种语言运行时多语言消息，覆盖 .NET Framework 4.6.1 至 .NET Standard 2.1 共 3 个目标框架。</PackageDescription>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/iot</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.Audio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>音频;Audio;PCM;G711;G722;G726;ADPCM;Opus;MP3;AAC;FLAC;Vorbis;Speex;DSP;VAD;AEC;AGC;NS;RTP;RTSP;新生命团队;NewLife;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>运行时多语言词表扩展到 31 种语言并对齐 NewLife.Core 12，程序集标题与描述同步本地化；全面适配 NativeAOT，AOT 冒烟覆盖 19 项检查与多平台矩阵；新增 Android/iOS 移动端与 riscv64/s390x 指令集冒烟；统一多 TFM 程序集版本并接入二进制兼容门禁；修复 FLAC 36 位总采样数符号扩展与除零、RTP 序列号回绕死锁、容器探测后未复位流位置导致 PCM 丢首字节；测试迁移 xunit v3，315 个单元测试全部通过</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
