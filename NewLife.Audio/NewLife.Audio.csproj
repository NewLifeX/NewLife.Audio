<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;netstandard2.0;net461</TargetFrameworks>
    <AssemblyTitle>音频编解码</AssemblyTitle>
    <Description>支持各种音频到PCM的编解码</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 新生命开发团队</Copyright>
    <VersionPrefix>1.2</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <!-- 与历史通配符版本保持同一 build 编号（2000-01-01 起的天数），revision 固定为上限 65534，
         使多 TFM 产物版本一致且对已发布包单调递增，同时保持可重现构建 -->
    <BuildNumber>$([MSBuild]::Divide($([MSBuild]::Subtract($([System.DateTime]::Now.Ticks), 630822816000000000)), 864000000000))</BuildNumber>
    <AssemblyVersion>$(VersionPrefix).$(BuildNumber).65534</AssemblyVersion>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/iot</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.Audio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>音频;Audio;PCM;G711;G722;G726;ADPCM;Opus;MP3;AAC;FLAC;Vorbis;Speex;DSP;VAD;AEC;AGC;NS;RTP;RTSP;新生命团队;NewLife;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>新增 AudioStudio 跨平台桌面客户端（Avalonia，PLAY/CONV/DEVICE/REC/DSP/TOOL 六大模块 28 项功能 100%）；编解码器全面 Span 化与性能优化；重构 ADPCM 状态类并修复 WAV 头；新增 AAC AudioSpecificConfig 封装；编解码器与容器接口健壮性修复；核心库 47 项功能 100% 完成，269 单元测试全覆盖</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1019-beta0659" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
