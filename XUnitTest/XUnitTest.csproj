<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <OutputPath>..\Bin\UnitTest</OutputPath>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\mp3\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageReference Include="NewLife.IoT" Version="3.1.2026.1022-beta0136" />
    <PackageReference Include="NewLife.PC" Version="1.0.2026.609" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- Windows 下验证系统语音引擎；其他平台不引入 Windows 专用包 -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.Audio\NewLife.Audio.csproj" />
  </ItemGroup>

</Project>

