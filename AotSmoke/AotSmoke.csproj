<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AotSmoke</RootNamespace>
    <PublishAot>true</PublishAot>
    <!-- IL2091：FaacEncoder 仅为兼容保留并已标记 [Obsolete]，AAC 编解码主链路不再使用 libfaac；
         但库以 netstandard 为目标，DAM 属性来自 NewLife.Core polyfill（非 BCL 定义），ILC 无法识别该标注来源，
         仅对该遗留可选原生路径产生提示性告警，此处按设计豁免；下一主版本移除 FaacEncoder 后可一并删除 -->
    <NoWarn>$(NoWarn);IL2091</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewLife.Audio\NewLife.Audio.csproj" />
  </ItemGroup>
</Project>
